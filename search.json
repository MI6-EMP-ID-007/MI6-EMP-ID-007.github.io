---
layout: null
sitemap: false
---
{%- comment -%}
  Search index consumed by assets/js/search.js.
  Contains every post, plus any page that sets `searchable: true` in its front matter.
  (Only mark pages whose body is plain Markdown; Liquid-driven pages would index raw template code.)
{%- endcomment -%}
{%- assign searchable_pages = site.pages | where: "searchable", true -%}
[
{%- for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "type": "Post",
    "date": {{ post.date | date: "%b %-d, %Y" | jsonify }},
    "author": {{ post.author | jsonify }},
    "subtitle": {{ post.subtitle | strip_newlines | strip | jsonify }},
    "body": {{ post.content | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last and searchable_pages.size == 0 %},{% endunless %}
{%- endfor %}
{%- for p in searchable_pages %}
  {
    "title": {{ p.title | jsonify }},
    "url": {{ p.url | relative_url | jsonify }},
    "type": "Page",
    "date": "",
    "author": "",
    "subtitle": {{ p.subtitle | strip_newlines | strip | jsonify }},
    "body": {{ p.content | markdownify | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
